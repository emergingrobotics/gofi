# Environment files (secrets)
.env
.env.*
.envrc
*.env

# Session cookie jars (may contain live auth tokens)
cookies.txt

# Stray empty placeholder accidentally committed at repo root
/ssh

# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Guard against binaries accidentally built into the repo root (they belong in bin/).
# Leading slash anchors to root so the source package directories are unaffected.
/basic
/crud
/errors
/concurrent
/websocket
/list
/fixedips
/addfixedip
/delfixedip
/switches
/gofip
/gofips
/gofimac
/gofinet

# Go build artifacts
*.o
*.a
*.test
*.out

# Coverage reports
coverage.out
coverage.html
*.coverprofile

# Dependency directories
vendor/

